    "test:r102:classic-browser": "python tools/test-r102-classic-browser.py",
    "test:r104": "node --test tools/test-r104-regressions.cjs",
    "test:r104:classic-browser": "python tools/test-r102-classic-browser.py --r104 --output-dir review-r104/evidence/classic-browser",
    "db:demo:create": "python tools/create-demo-database.py",
    "db:demo:check": "python tools/create-demo-database.py --check",
    "dev:demo": "node tools/dev-demo.mjs",
    "test:r106": "node --test tools/test-r106-regressions.cjs tools/test-r106-release.mjs",
    "test:r106:demo": "python -m unittest discover -s tests/python -p \"test_r106_demo.py\"",
    "verify:hyperdrive:freshness": "node tools/verify-hyperdrive-freshness.mjs",
    "validate:classic:embedded": "node tools/build-classic-embedded.mjs --check",
    "test:r108": "node --test --test-concurrency=1 tools/test-r108-regressions.cjs tools/test-r108-workspaces.cjs tools/test-r108-auth.cjs tools/test-r108-sdk.cjs tools/test-r108-genetics.cjs",
    "typecheck:r108-core": "tsc -p tsconfig.r108-core.json",
    "test:r109": "node --test --test-concurrency=1 tools/test-r109-ai.cjs tools/test-r109-intents.cjs tools/test-r109-boundaries.cjs tools/test-r109-editorial.cjs tools/test-r109-documents.cjs",
    "test:r117": "node --test tools/test-r117-navigation-policy.cjs",
    "validate:merge-inventory": "node tools/validate-horse-reference-inventory.mjs",
    "build:donor": "cd src/donor-apps/modern-horse && { node -e \"process.exit(require('fs').existsSync('node_modules')?0:1)\" || npm ci --no-audit --no-fund --loglevel=error; } && npx vite build"
  },
