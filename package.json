    "test:r96:browser": "python tools/test-r96-browser.py",
    "test:r96:browser:offline": "python tools/test-r96-browser.py --offline",
    "build:r96:demo": "node tools/build-r96-demo.mjs",
    "validate:r96:demo": "node tools/build-r96-demo.mjs --check",
    "db:r96:preflight": "python tools/r96-preflight.py",
    "demo:r96": "python -m http.server 4174 --bind 127.0.0.1 --directory public",
    "db:pg:r96-concurrency": "node scripts/pg-r96-concurrency.mjs",
    "db:r96:n03-rehearse": "python3 scripts/r96-n03-rehearse.py",
    "test:r97": "node --test tools/test-r97-runtime.cjs tools/test-r97-registry.cjs tools/test-r97-protocols.cjs",
    "db:r97:preflight": "python tools/r97-preflight.py",
    "validate:all-source-syntax": "node tools/validate-all-source-syntax.cjs",
    "db:pg:r97-concurrency": "node scripts/pg-r97-concurrency.mjs",
    "rehearse:r97-n03": "python3 scripts/r97-n03-rehearse.py",
    "test:r98": "node --test tools/test-r98-directory.cjs tools/test-r98-trust.cjs tools/test-r98-sql.cjs tools/test-r98-sdk.cjs tools/test-r98-retention.cjs",
    "test:review-native": "node --test --test-concurrency=1 tools/test-r95-runtime.cjs tools/test-r96-runtime.cjs tools/test-r97-runtime.cjs tools/test-r97-registry.cjs tools/test-r97-protocols.cjs tools/test-r98-directory.cjs tools/test-r98-trust.cjs tools/test-r98-sql.cjs tools/test-r98-sdk.cjs tools/test-r98-retention.cjs tools/test-r102-regressions.cjs tools/test-r104-regressions.cjs tools/test-r106-regressions.cjs tools/test-r106-release.mjs tools/test-r108-regressions.cjs tools/test-r108-workspaces.cjs tools/test-r108-auth.cjs tools/test-r108-sdk.cjs tools/test-r108-genetics.cjs tools/test-r109-ai.cjs tools/test-r109-intents.cjs tools/test-r109-boundaries.cjs tools/test-r109-editorial.cjs tools/test-r109-documents.cjs",
    "validate:sql-bindings": "node tools/validate-sql-bindings.cjs",
    "db:r98:preflight": "python tools/r98-preflight.py",
    "build:r98:demo": "node tools/build-r96-demo.mjs",
    "demo:r98": "python -m http.server 4174 --bind 127.0.0.1 --directory public",
    "test:r102": "node --test tools/test-r102-regressions.cjs",
    "build:navigation": "node tools/build-navigation-model.cjs",
