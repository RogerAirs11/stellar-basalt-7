{
  "name": "horse-registry-nextgen",
  "version": "0.101.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/dev-launch.mjs",
    "dev:qa": "node tools/dev-launch.mjs --strict-qa",
