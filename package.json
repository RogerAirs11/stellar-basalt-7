    "@libsql/client": "^0.15.15",
    "@tursodatabase/serverless": "1.4.0",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "pg": "^8.23.1",
    "postgres": "3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260820.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.5",
    "html-minifier-terser": "^7.2.0",
    "tailwindcss": "^4.3.3",
    "terser": "5.51.2",
    "typescript": "^5.8.0",
