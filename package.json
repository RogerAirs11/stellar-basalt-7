    "db:sync": "node scripts/db-sync.mjs status",
    "typecheck": "tsc --noEmit",
    "typecheck:backend-core": "tsc -p tsconfig.backend-core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run validate:navigation && npm run validate:classic:embedded && npm run test:r108 && npm run test:r109 && npm run typecheck:r108-core && npm run validate:platform && npm run validate:ai && npm run test:ai-protocol && npm run test:ai-runtime && npm run test:ai-storage && npm run test:ai-boundaries && npm run test:ai-result-budget && npm run test:ai-content && npm run validate:content && npm run validate:mobile-ux && npm run validate:registry-mobile && npm run validate:launcher && npm run validate:frontends && npm run validate:frontend-assets:source && npm run validate:heritage-boundary && npm run validate:equidata && npm run validate:design-systems && npm run validate:css && npm run validate:ui-42 && npm run validate:presentation && npm run validate:language && npm run validate:visible-surfaces && npm run validate:admin-records && npm run validate:stage2 && npm run validate:premium && npm run validate:premium-presentation && npm run validate:syntax && npm run validate:budgets && npm run validate:inventories && npm run validate:merge-inventory && npm run typecheck:frontend-kit && npm run typecheck:pedigree && npm run typecheck:backend-core && npm run verify:pedigree:reference && npm run typecheck && npm test && npm run check:python",
    "check:python": "python -m py_compile tools/import_xlsx.py tools/export_sqlite_to_d1.py tools/make_admin.py tools/verify_sqlite.py tools/compare_canonical.py tools/analyze_pedigree.py tools/ensure_schema.py tools/build_analytics_snapshot.py && npm run test:python && node tools/cleanup-python-cache.mjs",
    "db:migrate:remote": "node tools/require-r95-release-approval.mjs && wrangler d1 migrations apply horse-registry --remote",
    "cf:types": "wrangler types",
    "test:python": "python -m unittest discover -s tests/python -p \"test_*.py\"",
    "dev:raw": "vite dev --mode sqlite --host 127.0.0.1 --port 3000",
    "db:verify:sqlite": "python tools/verify_sqlite.py data/generated/horse-registry.sqlite",
    "analyze:pedigree": "python tools/analyze_pedigree.py data/generated/horse-registry.sqlite",
    "db:export:d1": "python tools/export_sqlite_to_d1.py data/generated/horse-registry.sqlite --out data/generated/remote-d1-shards",
    "deploy:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-cloudflare.ps1",
    "deploy:cloudflare:data": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-cloudflare.ps1 -ImportLocalSqlite -ReplaceRemoteRegistry",
    "db:refresh:sqlite": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rebuild-local-sqlite.ps1",
    "validate:frontends": "node tools/validate-frontends.mjs",
    "validate:frontends:json": "node tools/validate-frontends.mjs --json",
    "typecheck:frontend-kit": "tsc -p tsconfig.frontend-kit.json",
    "frontend:new": "node tools/new-frontend.mjs",
    "typecheck:pedigree": "tsc -p tsconfig.pedigree.json",
    "analytics:registry": "python tools/build_analytics_snapshot.py data/generated/horse-registry.sqlite --if-stale",
    "verify:pedigree:reference": "node tools/verify-pedigree-coefficients.mjs",
    "validate:heritage-boundary": "node tools/validate-heritage-public-reads.mjs",
    "validate:equidata": "node tools/validate-equidata-integration.mjs",
    "validate:design-systems": "node tools/validate-design-systems.mjs",
    "validate:platform": "node tools/validate-platform-contract.mjs",
    "validate:presentation": "node tools/validate-presentation-parity.mjs",
    "validate:visible-surfaces": "node tools/validate-visible-surface-parity.mjs",
    "validate:syntax": "node tools/validate-source-syntax.mjs",
    "validate:admin-records": "node tools/validate-admin-record-parity.mjs",
    "validate:stage2": "node tools/validate-stage2-adaptive-parity.mjs",
    "validate:premium": "node tools/validate-premium-analytics-parity.mjs",
    "validate:premium-presentation": "node tools/validate-premium-presentation-completeness.mjs",
    "benchmark:reference-sampling": "python tools/benchmark_reference_sampling.py data/generated/horse-registry.sqlite",
    "validate:ui-42": "node tools/validate-core-ui-42.mjs",
    "validate:budgets": "node tools/validate-free-tier-budgets.mjs",
    "validate:inventories": "node tools/validate-operational-inventories.mjs",
    "validate:launcher": "node tools/validate-launcher-freshness.mjs",
    "validate:css": "node tools/validate-css-architecture.mjs",
    "validate:registry-mobile": "node tools/validate-registry-mobile-view.mjs",
    "validate:frontend-assets:source": "node tools/validate-production-frontend-assets.mjs --source",
    "validate:frontend-assets:dist": "node tools/validate-production-frontend-assets.mjs --dist",
    "validate:content": "node tools/validate-content-newsroom.mjs",
    "validate:mobile-ux": "node tools/validate-mobile-ux-system.mjs",
    "validate:ai": "node tools/validate-ai-assistant.mjs",
    "test:ai-protocol": "node tools/test-ai-provider-protocols.mjs",
    "test:ai-runtime": "node tools/test-ai-runtime-policies.mjs",
    "test:ai-storage": "node tools/test-ai-storage.mjs",
    "test:ai-realdata": "vitest run tests/ai-realdata.test.ts",
    "smoke:ai": "node tools/smoke-ai-providers.mjs",
    "test:ai-boundaries": "node tools/test-ai-boundaries.mjs",
    "test:ai-result-budget": "node tools/test-ai-result-budget.mjs",
    "test:ai-content": "node tools/test-ai-content-generation.mjs",
    "validate:language": "node tools/validate-language-localization.mjs",
    "preview:serve": "node tools/preview-serve.mjs",
    "test:audit": "node tools/test-audit-regressions.mjs",
    "test:audit-sql": "python -m unittest discover -s tests/python -p \"test_audit_regressions.py\"",
    "build:classic:embedded": "node tools/build-classic-embedded.mjs",
    "db:pg-parity": "node scripts/pg-parity-gate.mjs",
    "db:pg-execution-parity": "node scripts/pg-execution-parity.mjs",
    "generate:r88:demo": "node tools/generate-r88-demo.mjs",
    "generate:r88:density": "node tools/generate-r88-density-tokens.mjs",
    "validate:r88:density": "node tools/generate-r88-density-tokens.mjs --check",
    "test:r88": "node tools/test-r88-boundaries.mjs && node tools/test-r88-science.mjs && node tools/test-r88-economics.mjs",
    "test:r88:dom": "python tools/test-r88-dom.py",
    "test:r88:browser": "python tools/test-r88-browser.py",
    "demo:r88": "python -m http.server 4174 --bind 127.0.0.1 --directory public",
    "validate:r88:demo": "node tools/generate-r88-demo.mjs --check && node tools/validate-r88-demo.mjs",
