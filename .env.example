# No secrets are committed here. Put your own GEMINI_API_KEY in local .env,
# or use `wrangler secret put GEMINI_API_KEY` for a deployment.

# R31 Canonical AI Research Assistant (server-side only)
# Local setup: copy this file to .env and set GEMINI_API_KEY below.
# The example enables the feature but contains no secret, so a copied .env works
# as soon as a provider key is supplied. Production still uses explicit secrets.
AI_ASSISTANT_ENABLED=1
AI_GEMINI_ENABLED=1
GEMINI_API_KEY=

# Sandbox-only escape hatch: deterministic offline AI provider (no network calls)
# used when the runtime region is geo-blocked by Google. Never enable in production.
# AI_OFFLINE_SANDBOX=1

# Researched conservative free-tier defaults (2026-09-16).
# Google now says active limits vary by project/model and should be checked in AI Studio.
# Horse-DB also keeps AI_GEMINI_RESERVE_FRACTION below each configured limit.
AI_GEMINI_FLASH_LITE_RPM_LIMIT=15
AI_GEMINI_FLASH_LITE_INPUT_TPM_LIMIT=250000
AI_GEMINI_FLASH_LITE_RPD_LIMIT=500
AI_GEMINI_FLASH_RPM_LIMIT=5
AI_GEMINI_FLASH_INPUT_TPM_LIMIT=1000000
AI_GEMINI_FLASH_RPD_LIMIT=20
AI_GEMINI_RESERVE_FRACTION=0.12
# Optional advanced guards. Blank replay limit = derive from model/TPM headroom.
AI_GEMINI_REPLAY_MAX_TOKENS=
AI_GEMINI_COUNT_TOKENS_THRESHOLD_FRACTION=0.72
AI_GEMINI_TRANSIENT_429_RETRY_MAX_MS=3000

# Legacy one-size overrides. Leave blank to use the model-specific defaults above.
AI_GEMINI_RPM_LIMIT=
AI_GEMINI_INPUT_TPM_LIMIT=
AI_GEMINI_RPD_LIMIT=

# Paid fallback is explicit opt-in.
AI_DEEPSEEK_ENABLED=0
DEEPSEEK_API_KEY=
AI_DEEPSEEK_VISION_ENABLED=0
AI_DEEPSEEK_MAX_REQUEST_USD=0.05
AI_DEEPSEEK_MAX_DAILY_USD=1.00
AI_DEEPSEEK_INPUT_ESTIMATE_MULTIPLIER=1.35
AI_DEEPSEEK_CACHE_HIT_PER_MILLION_USD=0.006
AI_DEEPSEEK_CACHE_MISS_PER_MILLION_USD=0.30
AI_DEEPSEEK_OUTPUT_PER_MILLION_USD=1.20
AI_CONTEXT_SAFETY_FRACTION=0.90
AI_OUTPUT_TOKENS_FAST=4096
AI_OUTPUT_TOKENS_AUTO=8192
AI_OUTPUT_TOKENS_RESEARCH=16384
AI_MAX_TOOL_CALLS_FAST=4
AI_MAX_TOOL_CALLS_AUTO=8
AI_MAX_TOOL_CALLS_RESEARCH=12
AI_MAX_TOOL_ROUNDS_FAST=2
AI_MAX_TOOL_ROUNDS_AUTO=4
AI_MAX_TOOL_ROUNDS_RESEARCH=6
AI_GEMINI_WEB_GROUNDING_ENABLED=0

# R95: financial capabilities remain off until an approved end-to-end pilot.
BILLING_LIVE_PAYMENTS_ENABLED=false
# Fixed HTTPS public origin, never derived from the browser request Host.
PAYMENT_CALLBACK_BASE_URL=
ZARINPAL_MERCHANT_ID=
# Release-owner approval for an exact commit; blank blocks deployment.
R95_PRODUCTION_RELEASE_APPROVED_SHA=

# Database authority: production uses Supabase for registry, auth, audit and AI.
# The local SQLite Vite plugin explicitly selects d1_only; do not put secrets in VITE_* variables.
DB_PROVIDER_MODE=supabase_full
# Set via deployment secrets (or SUPABASE_HYPERDRIVE binding), never commit credentials.
SUPABASE_DATABASE_URL=
# Optional alternate stores; switching provider is NOT replication or disaster recovery.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Legacy read-failover modes are anonymous, allowlisted snapshot reads only.
# Never fail over private data or writes without a current, verified recovery plan.

# R104 additive single-authority candidates (NOT automatic failover):
# DB_PROVIDER_MODE=d1_full or turso_full binds registry, auth and AI to ONE store.
# Keep supabase_full for the current production deployment. Before promotion,
# migrate/verify ALL state, stop old writers, and pass the real-provider gates.
# Legacy d1_only/turso_only retain their existing separate AUTH_DB/AI_DB behavior.
# See review-r104/DATABASE_RUNBOOK.md. Production allowlist is not expanded here.

# R106 local-development safety. Default development binding is loopback only.
# One-click admin requires an explicit local flag and is NEVER available in production.
ENABLE_DEMO_ADMIN_LOGIN=0
# Private sandbox proxy only: comma-separated exact hostnames, not a wildcard.
HORSE_REGISTRY_DEV_ALLOWED_HOSTS=
# Set by the isolated demo launcher only after checking its database marker.
# REGISTRY_DATASET_KIND=synthetic
# Nonempty data is NOT classified synthetic from its row count.

# R109: editorial gemini-3.8-flash is distinct from the retained chat model.
# Fill these ONLY with ceilings approved from the active project's AI Studio.
# Unset values deliberately pause this editorial model; no free quota is assumed.
AI_GEMINI_38_FLASH_RPM_LIMIT=
AI_GEMINI_38_FLASH_INPUT_TPM_LIMIT=
AI_GEMINI_38_FLASH_RPD_LIMIT=

# R148 account security (server only). Optional supports staged enrollment;
# required blocks authenticated business mutations and privileged reads until
# recent factor proof exists. Enroll ordinary writers as well as staff before
# enabling it; login, logout and MFA setup/recovery retain their own auth flow.
# Production private care additionally requires MFA_MODE=required.
MFA_MODE=optional
# Configure MFA_KEYRING_JSON as a Worker secret, never a VITE_ variable.
# Shape only: {"active_key_id":"key-id","keys":{"key-id":"BASE64_32_RANDOM_BYTES"}}
# Generate the real key into protected operator storage. Do not commit it.
